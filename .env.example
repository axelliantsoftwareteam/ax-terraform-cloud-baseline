# Core AWS execution context
AWS_PROFILE=example-platform
AWS_REGION=us-east-1

# Optional Terraform behavior controls
TF_IN_AUTOMATION=true
TF_INPUT=false

# Optional observability context for tf-runner structured logs
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_TRACE_ID=

# Default environment used by local helper commands
AX_ENV=dev
